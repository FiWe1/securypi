# To run the app as a systemd service, execute the following:
#
# sudo cp ./scripts/systemd_services/securypi.service /etc/systemd/system/securypi.service
# sudo systemctl daemon-reload
# sudo systemctl enable securypi.service && sudo systemctl start securypi.service
#
# view logs:
# journalctl -u securypi.service

[Unit]
Description=Securypi Flask App
# UNCOMMENT WHEN USING QMP6988 PRESSURE SENSOR:
# Requires=pigpiod.service
# After=pigpiod.service

[Service]
Type=simple
User=fiwe1
WorkingDirectory=/home/fiwe1/Coding/securypis/securypi_demo

ExecStart=/bin/bash /home/fiwe1/Coding/securypis/securypi_demo/scripts/app_run.sh

Restart=on-failure

[Install]
WantedBy=multi-user.target
